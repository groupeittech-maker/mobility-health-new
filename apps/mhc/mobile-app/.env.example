# Android FCM : ajoutez android/app/google-services.json (Firebase Console, même package que applicationId Gradle).
# Backend : FCM_SERVER_KEY + worker Celery pour l’envoi des push.

# Configuration API - Backend
# Production (Hostinger)
API_BASE_URL=https://api.srv1324425.hstgr.cloud/api/v1
API_CONNEXION_BACKEND=https://api.srv1324425.hstgr.cloud
