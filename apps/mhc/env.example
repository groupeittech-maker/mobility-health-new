# Database
# Pour le développement : SQLite (par défaut)
DATABASE_URL=sqlite:///./mobility_health.db

# Pour la production : PostgreSQL (décommenter quand nécessaire)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mobility_health
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobility_health

# Redis
REDIS_URL=redis://localhost:6379/0

# Minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Repli disque si MinIO est indisponible (photos e-carte, pièces projet). En Docker : monter ce chemin.
LOCAL_FILE_STORAGE_ROOT=/var/lib/mobility-health/uploads

# Si MinIO est interne (minio:9000, localhost), définir l’URL publique de l’API pour que
# les e-cartes soient servies via l’API (évite que le navigateur tente d’ouvrir minio:9000).
# Ex: https://srv1324425.hstgr.cloud (sans /api/v1)
# API_PUBLIC_BASE_URL=https://srv1324425.hstgr.cloud

# JWT
SECRET_KEY=your-secret-key-change-in-production-very-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=True
ENVIRONMENT=development

# Services externes IT-Tech (stub | live)
PAYMENT_SERVICE_URL=
PAYMENT_SERVICE_API_KEY=
PAYMENT_SERVICE_MODE=stub

OCR_SERVICE_URL=
OCR_SERVICE_API_KEY=
OCR_SERVICE_MODE=stub

TRUST_SERVICE_URL=
TRUST_SERVICE_API_KEY=
TRUST_SERVICE_MODE=stub

# CORS: Liste des origines autorisées (séparées par des virgules)
# En production, l'origine du frontend doit être autorisée (ex: https://srv1324425.hstgr.cloud)
# Exemple: CORS_ORIGINS=https://srv1324425.hstgr.cloud,http://localhost:3000,http://192.168.1.183:8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000,http://192.168.1.183:8000

# Assurance / Attestation
ASSURANCE_NAME=Mobility Health Assurance
ASSURANCE_ADDRESS=Plateau, Abidjan, Cote d'Ivoire
ASSURANCE_PHONE=+22500000000
ASSURANCE_EMAIL=support@mobilityhealth.com
ASSURANCE_AGENT_NAME=Equipe Mobility Health
ASSURANCE_AGENT_TITLE=Representant habilite
ASSURANCE_CITY=Abidjan

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mobilityhealth.com
SMTP_FROM_NAME=Mobility Health
ASSURANCE_SITE_WEB=https://srv1324425.hstgr.cloud

# SMS (Twilio - optionnel)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Push Notifications (FCM)
# Recommandé (Google n'affiche plus la clé serveur legacy) : compte de service HTTP v1
# Téléchargement : Firebase Console → Paramètres du projet → Comptes de service → Générer une nouvelle clé privée
FCM_SERVICE_ACCOUNT_PATH=/chemin/vers/firebase-adminsdk-xxxxx.json
# Alternative Docker/K8s : coller le JSON (échapper les guillemets ou utiliser un secret monté en fichier)
# FCM_SERVICE_ACCOUNT_JSON=
# Ou variable standard Google (si PATH vide) :
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/serviceAccount.json
# Ancienne API (si encore proposée par Google) :
# FCM_SERVER_KEY=
FCM_PROJECT_ID=your-project-id

# --- Production (docker-compose.prod.yml) : fichier JSON sur le VPS + montage dans le conteneur
# Sur le serveur : placer le JSON (ex. /var/www/Mobility_Health/Mobility_Health/secrets/firebase-sa.json), chmod 600.
# FCM_SERVICE_ACCOUNT_HOST_PATH=/var/www/Mobility_Health/Mobility_Health/secrets/firebase-sa.json
# FCM_SERVICE_ACCOUNT_CONTAINER_PATH=/run/secrets/firebase-sa.json
# FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

